# Copy to .env and fill in. Only the LLM_* values are required.

# Any OpenAI-compatible API with tool calling + streaming.
# For a model running on your Mac (Ollama, LM Studio...), use http://host.docker.internal:<port>/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# Set by docker-compose.yml; only needed when running outside Docker.
# REDIS_URL=redis://localhost:6379/0

# Optional tool keys. Without them the tool says it is not configured
# (web search falls back to DuckDuckGo).
TAVILY_API_KEY=
RAPIDAPI_KEY=
AVIATIONSTACK_API_KEY=
